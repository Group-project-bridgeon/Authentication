# SERVER CONFIGURATION
PORT=8080
SERVER_PORT=8080
APP_ENV=development

# DATABASE CONFIGURATION
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth?sslmode=disable

# JWT CONFIGURATION
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_ISSUER=erp-auth
JWT_AUDIENCE=erp-api
JWT_EXPIRY=15m

# GOOGLE OAUTH CONFIGURATION
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# SMTP EMAIL CONFIGURATION
# Provide your SMTP credentials below to send real emails (e.g., Gmail, SendGrid, Mailgun, AWS SES).
# If SMTP_HOST is empty or set to "mock", the server will log OTPs directly to console for easy development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME="Authentication Service"
